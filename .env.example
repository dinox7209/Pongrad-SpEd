# ==============================================================================
# ระบบจัดการสื่อการสอนและติดตามนักเรียนการศึกษาพิเศษ (Pongrad SpEd)
# โรงเรียนวัดโป่งแรด (ปคุณวิทยาคาร) สพป.จันทบุรี เขต 1
# ==============================================================================

# 1. Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# ใช้ฝั่ง Server สำหรับ Cron Job และตรวจสิทธิ์สตรีมสื่อสาธารณะ/ส่วนตัว
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Drive API (Google Service Account)
# วิธีที่ 1: ใส่ JSON ทั้งก้อนของ Service Account Key (แนะนำสำหรับ Vercel)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# วิธีที่ 2: แยก Client Email และ Private Key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# ID ของโฟลเดอร์หลักใน Google Drive (ต้องแชร์โฟลเดอร์นี้ให้ Service Account Email เป็น Editor)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# 3. Vercel Cron & LINE Reminder
# ตั้งรหัสลับสุ่มสำหรับป้องกัน endpoint /api/cron/reminder
CRON_SECRET=replace-with-random-secret-string

# แนะนำ: LINE Messaging API (Official - ใช้ได้หลัง LINE Notify ปิดให้บริการ)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# User ID หรือ Group ID ปลายทาง (เว้นว่างเพื่อส่งแบบ Broadcast ถึงผู้ติดตามทั้งหมดของ OA)
LINE_TARGET_ID=

# ทางเลือกสำรอง: หากใช้ Gateway ที่รองรับรูปแบบ LINE Notify เดิม
LINE_NOTIFY_TOKEN=
LINE_NOTIFY_ENDPOINT=https://notify-api.line.me/api/notify
